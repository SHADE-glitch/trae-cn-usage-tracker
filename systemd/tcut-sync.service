[Unit]
Description=Trae CN usage tracker sync
Documentation=https://github.com/SHADE-glitch/trae-cn-usage-tracker/blob/master/README.md

[Service]
Type=oneshot
# %h-relative on purpose: systemd's user PATH does not include ~/.local/bin, and
# an absolute path would hardcode one machine's home directory.
ExecStart=%h/.local/bin/tcut sync --quiet
Environment=LANG=C.UTF-8
Environment=PYTHONIOENCODING=utf-8
Nice=10
